# Fill in a copy named .env for setup-repository.ps1; a key left empty is not set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=
SIGNING_SUBJECT=
SIGNING_STORE=
# Only sign-pending.ps1 on the signing machine reads this: the AWS CLI profile of the store, never set on a repository.
AWS_PROFILE=
